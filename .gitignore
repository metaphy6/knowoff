# local state
.venv/
.tools/ffmpeg/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# scaffold output / per-project agent runtime
docs/tracking/state/*
!docs/tracking/state/.gitkeep

# editor noise
.idea/
*.swp
*.swo

# user-local overrides
.env
.env.local

# Go
server/knowoffd
server/tmp/
tools/gamebot/gamebot
*.exe

# Flutter / Dart
client/build/
client/.dart_tool/
client/.flutter-plugins
client/.flutter-plugins-dependencies
client/.packages
client/pubspec.lock
client/android/app/debug
client/android/app/profile
client/android/app/release
client/ios/Pods/
client/ios/.symlinks/
client/macos/
client/windows/
client/linux/
client/web/icons/  # generated by flutter create; keep only custom icons if added

# Localizations untranslated file
client/untranslated.json

# Generated Dart files
client/lib/l10n/app_localizations*.dart

# nginx: generated/mounted TLS certs — never commit key material

nginx/certs/selfsigned/
nginx/certs/active/
nginx/certs/external/*
!nginx/certs/external/.gitkeep

# Local candidate imagery and generation receipts (owner-requested initial batch)
content/batches/*/generated/
